{
	"name": "@lobstrio/n8n-nodes-lobstr",
	"version": "0.1.1",
	"description": "n8n community node for lobstr.io — run cloud scrapers (squids), manage tasks and runs, fetch structured results, and trigger workflows on run events",
	"keywords": [
		"n8n-community-node-package",
		"lobstr",
		"lobstr.io",
		"web scraping",
		"scraper",
		"crawler",
		"data extraction",
		"automation"
	],
	"license": "MIT",
	"homepage": "https://www.lobstr.io",
	"author": {
		"name": "lobstr.io",
		"email": "shehriar.awan@lobstr.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lobstrio/n8n-nodes-lobstr.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist tsconfig.tsbuildinfo && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/LobstrApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Lobstr/Lobstr.node.js",
			"dist/nodes/LobstrTrigger/LobstrTrigger.node.js"
		]
	},
	"devDependencies": {
		"@typescript-eslint/parser": "~8.32.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"prettier": "^3.5.3",
		"rimraf": "^5.0.10",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
